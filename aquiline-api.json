    "/v1/profiles/{profileId}/orders/{orderId}/assign": {
      "post": {
        "tags": [
          "9 · Aquiline tracking assignment"
        ],
        "summary": "Register Aquiline tracking for an order",
        "description": "Submit the carrier-facing tracking signal Aquiline should follow (Amazon tracking page URL; AliExpress or Walmart with `carrier` and tracking number — no `retailer` for Walmart).\n\nEnsure **storeAddress** is populated on the profile first—Aquiline uses it when talking to carriers. After this call succeeds, the order is monitored inside Aquiline the same way as orders created from the web app.\n",
        "operationId": "integrationOrdersAssign",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/profileId"
          },
          {
            "$ref": "#/components/parameters/orderId"
          }
        ],
        "requestBody": {
