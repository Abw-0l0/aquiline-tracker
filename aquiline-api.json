        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "example": {
                  "success": true,
                  "items": [
                    {
                      "id": "wh_abc",
                      "url": "https://example.com/hooks/aquiline",
                      "events": [
                        "tracking.html.accepted",
                        "tracking.problem.opened"
                      ],
                      "active": true,
                      "secretHint": "abcd…wxyz"
                    }
                  ]
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "10 · Webhooks"
        ],
        "summary": "Create Integration webhook",
        "description": "Subscribe to tracking HTML / problem events for your account.\nSignature header: `X-Webhook-Signature: sha256=<hex hmac of raw body with your secret>`.\n\nEvent types: `tracking.html.accepted`, `tracking.html.applied`, `tracking.html.rejected`,\n`tracking.problem.opened`, `tracking.problem.cleared`.\n\nPayload shape: `{ \"event\": \"<name>\", \"createdAt\": \"<iso>\", \"data\": { ... } }`.\n`data` always includes `profileId` and `orderId` (marketplace order id). AQUA number is not included.\n`problemCode` / `message` appear on rejected / problem events (public codes only).\n\nExamples:\n- `tracking.html.applied` → `data: { profileId, orderId, outcome: \"applied\" }`\n- `tracking.html.accepted` → `data: { profileId, orderId, outcome: \"accepted\", problemCode? }`\n- `tracking.html.rejected` → `data: { profileId, orderId, outcome: \"rejected\", problemCode, message }`\n  (HTTP error response is still returned; webhook is delivered best-effort)\n- `tracking.problem.opened` → `data: { profileId, orderId, problemCode, message }`\n- `tracking.problem.cleared` → `data: { profileId, orderId, previousProblemCode? }`\n",
        "operationId": "integrationWebhooksCreate",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "url"
                ],
                "properties": {
                  "url": {
                    "type": "string",
                    "description": "HTTPS endpoint"
                  },
                  "events": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "secret": {
                    "type": "string",
                    "description": "Optional; generated if omitted"
                  }
                }
              },
              "example": {
                "url": "https://example.com/hooks/aquiline",
                "events": [
                  "tracking.problem.opened",
                  "tracking.html.applied"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Created (includes secret once)"
          }
        }
      }
    },
    "/v1/webhooks/{webhookId}": {
      "delete": {
