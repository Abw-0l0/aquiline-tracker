{
  "openapi": "3.0.3",
  "info": {
    "title": "Aquiline Customer Integration API",
    "version": "1.0.0",
    "description": "HTTP API for creating marketplace profiles, syncing orders, and assigning Aquiline tracking to customer orders.\n\n**Authentication:** include  \n`Authorization: Bearer <integrationTokenId>.<integrationTokenSecret>`  \n(create the token in the app under **Dashboard → Integration API**).\n\n**Marketplaces:** Amazon, AliExpress, and Walmart (including Walmart native tracking numbers with `carrier: WALMART`).\n- **Amazon:** after you upsert orders, send fresh **order / shipment HTML** from a signed-in Amazon session about **1–2 times per day** so Aquiline can keep carrier and delivery context current.\n- **AliExpress / Walmart (3PL):** upsert the order with carrier tracking number (`FEDEX`, `UPS`, `USPS`, `ONTRAC`, …), then assign.\n- **Walmart native:** use `carrier: WALMART` and put the Walmart tracking number in `trackingUrl` (same pattern as USPS native numbers).\n"
  },
  "tags": [
    {
      "name": "1 · Account",
      "description": "Who the token belongs to and current plan context."
    },
    {
      "name": "2 · Create profile",
      "description": "Register a marketplace source (Amazon or AliExpress) before syncing orders."
    },
    {
      "name": "3 · List profiles",
      "description": "Browse configured sources."
    },
    {
      "name": "4 · Profile by id",
      "description": "Read or update label, marketplace host, and ship-from / return address used for tracking."
    },
    {
      "name": "5 · List orders",
      "description": "Orders stored for a profile."
    },
    {
      "name": "6 · Order by id",
      "description": "Full snapshot for one marketplace order id."
    },
    {
      "name": "7 · Upsert orders",
      "description": "Idempotent ingest of order rows keyed by marketplace order id."
    },
    {
      "name": "8 · Amazon order page refresh",
      "description": "Upload HTML for an Amazon order or tracking page so Aquiline can refresh carrier signals."
    },
    {
      "name": "9 · Aquiline tracking assignment",
      "description": "Hand off carrier / tracking details so the order is followed inside Aquiline."
    }
  ],
  "servers": [
    {
      "url": "https://aquiline-tracking.com/app/api/integration",
      "description": "Production"
    }
  ],
  "paths": {
    "/v1/me": {
      "get": {
        "tags": [
          "1 · Account"
        ],
        "summary": "Current account and usage",
        "description": "Returns the authenticated user id, subscription flags, and plan limits for dashboards and guardrails.",
        "operationId": "integrationMe",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "example": {
                  "success": true,
                  "uid": "usr_1234567890",
                  "subscriptionActive": true,
                  "billing": {
                    "subscription": {
                      "planCode": "starter",
                      "cadence": "monthly",
                      "status": "active",
                      "currentPeriodEnd": "2026-05-29T00:00:00.000Z"
                    },
                    "usage": {
                      "windowKey": "2026-05",
                      "used": 12,
                      "limit": 300,
                      "remaining": 288
                    },
                    "plan": {
                      "code": "starter",
                      "label": "Starter",
                      "trackLimitPerMonth": 300
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
