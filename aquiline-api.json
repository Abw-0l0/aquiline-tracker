                      "country": "US",
                      "phone_number": "0000000000"
                    },
                    "productTitle": "Example Amazon product",
                    "productId": "B000000000",
                    "productUrl": "https://www.amazon.com/dp/B000000000",
                    "orderUrl": "https://www.amazon.com/gp/your-account/order-details?orderID=113-0000000-0000000",
                    "trackingUrl": "https://www.amazon.com/gp/your-account/ship-track?orderId=113-0000000-0000000",
