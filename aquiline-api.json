    "/v1/profiles/{profileId}/orders/{orderId}/tracking-html": {
      "post": {
        "tags": [
          "8 · Amazon order page refresh"
        ],
        "summary": "Upload Amazon order HTML (Amazon profiles only)",
        "description": "Provide HTML from the live Amazon **tracking** page (progress tracker / ship-track) while the buyer session is still valid.\nDo **not** upload the order-details page.\n\nPlan on refreshing about **once or twice per day** per active Amazon profile so Aquiline keeps up with carrier milestones.\n\n**Important:** HTTP `success: true` means the HTML was **accepted** (stored and validated). It does **not** always mean updates were already **applied** to the Aquiline tracking number.\nCheck `outcome`: `accepted` | `applied`. While parsing is in progress, `trackingUpdateStatus` is `processing` (Firestore `trackingHealth` on the order). Hard failures return `problemCode`. Never treat success alone as “applied”.\n",
        "operationId": "integrationOrdersTrackingHtml",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/profileId"
          },
          {
            "$ref": "#/components/parameters/orderId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TrackingHtmlBody"
              },
              "example": {
                "trackingUrl": "https://www.amazon.com/gp/your-account/ship-track?orderId=113-0000000-0000000",
                "html": "<html>Authenticated Amazon tracking page HTML...</html>"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "HTML accepted (and optionally applied)",
            "content": {
              "application/json": {
                "example": {
                  "success": true,
                  "outcome": "accepted",
                  "trackingUpdateStatus": "processing",
                  "message": "Processing updates…",
                  "result": {
                    "status": "success"
                  },
                  "trackingRefresh": {
                    "enqueued": true,
                    "parsed": false
                  },
                  "suggestAmazonEmailFetch": false
                }
              }
            }
          },
          "402": {
            "description": "Paid plan required"
          }
        }
      }
    },
    "/v1/webhooks": {
      "get": {
        "tags": [
