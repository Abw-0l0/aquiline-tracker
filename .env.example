# Server
PORT=3000
NODE_ENV=development

# Aquiline Customer Integration API
# Create the integration token in the Aquiline app under Dashboard -> Integration API
AQUILINE_BASE_URL=https://aquiline-tracking.com/app/api/integration
AQUILINE_TOKEN_ID=
AQUILINE_TOKEN_SECRET=
AQUILINE_TIMEOUT_MS=15000

# Logging
LOG_LEVEL=info
