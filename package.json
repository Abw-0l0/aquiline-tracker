{
  "name": "aquiline-sync-service",
  "version": "1.0.0",
  "description": "Stateless Node.js microservice that syncs marketplace orders into the Aquiline Customer Integration API (profile check/create + order upsert), with on-demand tracking HTML upload and tracking ID lookup.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "lint": "node --check server.js",
    "test": "jest"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFiles": [
      "<rootDir>/tests/setupEnv.js"
    ]
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "axios": "^1.7.7",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "joi": "^17.13.3",
    "winston": "^3.14.2"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nock": "^13.5.6",
    "nodemon": "^3.1.4"
  },
  "license": "UNLICENSED",
  "private": true
}
